# WUD-Updater environment template.
# Copy to $HOME/.config/wud-updater/env for host-side commands, then edit.

# Host paths and updater behavior.
DOCKER_BASE="$HOME/docker"
WUD_OUT_FILE="$DOCKER_BASE/wud/out/images.todo"
WUD_LOG_DIR="./logs"
WUD_UPDATE_MODE="stop"
WUD_MAX_WAIT="180"
WUD_LOCK_TIMEOUT="30"

# Optional: when running docker-update-from-wud through sudo, set these to the
# WUD container UID/GID so rewritten todo files and logs stay shared-writable.
# OUT_UID="1000"
# OUT_GID="1000"

# Optional: override the updater path used by bin/updates.
# WUD_UPDATER="$HOME/bin/docker-update-from-wud"

# Optional: run the Python updates wrapper instead of the default Bash wrapper.
# WUD_UPDATER_PYTHON="1"

# Optional for WUD_UPDATER_PYTHON=1: run WUD_UPDATER directly and require
# WUD_OUT_FILE plus its lock directory to be accessible without sudo.
# WUD_UPDATER_USE_SUDO="0"

# Optional for WUD_UPDATER_PYTHON=1 in the container: query TrueNAS status by
# starting a short-lived helper container with local middleware socket access.
# TRUENAS_STATUS_CHECK="1"
# TRUENAS_STATUS_TIMEOUT="5"

# Release-note webhooks and tokens belong in the WUD container environment
# unless you intentionally run those helpers on the host.
# DISCORD_RELEASES_WEBHOOK="https://discord.com/api/webhooks/example"
# DISCORD_WEBHOOK="https://discord.com/api/webhooks/example"
# ADMIN_WEBHOOK="https://discord.com/api/webhooks/example"
# GITHUB_TOKEN="ghp_example"
