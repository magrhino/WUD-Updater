# WUD-Updater environment template.
##### IMPORTANT NOTE #####
# Choose the right env file before copying:
# - Long-running WebUI Compose: copy docs/examples/webui.env.example.
# - Host-side updates/docker-update-from-wud: copy this file to
#   $HOME/.config/wud-updater/env, then edit.

# Host command essentials.
DOCKER_BASE="$HOME/docker"
WUD_OUT_FILE="$DOCKER_BASE/wud/out/images.todo"
WUD_LOG_DIR="./logs"
WUD_DB_PATH="$WUD_LOG_DIR/wud-updater.sqlite"
WUD_UPDATE_MODE="stop"
WUD_MAX_WAIT="180"
WUD_LOCK_TIMEOUT="30"
WUD_TIMEZONE="UTC"

# Optional host updater behavior.
#
# WUD_COMPOSE_IGNORE_PATHS is a comma-separated compose discovery archive list.
# The default is "old". Set an empty value to disable archive ignores.
# WUD_COMPOSE_IGNORE_PATHS="old,archive/disabled"

# Optional: pin approved tag updates to their verified tag/index digest instead
# of writing the resolved tag. Requires explicit tag-update approval.
# WUD_DIGEST_PIN_UPDATES="false"

# When running docker-update-from-wud through sudo, set these to the WUD
# container UID/GID so rewritten todo files and logs stay shared-writable.
# OUT_UID="1000"
# OUT_GID="1000"

# Host wrapper behavior.
#
# Optional: override the updater path used by bin/updates.
# WUD_UPDATER="$HOME/bin/docker-update-from-wud"

# Optional: override the repo-local venv used by install.sh and wrappers when
# host python3 is missing runtime dependencies.
# WUD_UPDATER_VENV="/path/to/WUD-Updater/.venv"

# Optional for the Python updates wrapper: run WUD_UPDATER directly and require
# WUD_OUT_FILE plus its lock directory to be accessible without sudo.
# WUD_UPDATER_USE_SUDO="false"

# Optional: startup banner and GitHub latest-release check controls.
# WUD_UPDATER_BANNER="auto"
# WUD_UPDATER_RELEASE_CHECK="auto"

# Optional: disable the default self-update preflight in updates.
# WUD_UPDATER_SELF_UPDATE="false"

# Optional host-local WebUI overrides.
#
# Use these when running `wud-updater web` directly on the host, or for advanced
# host wrapper usage. For the containerized first-run Compose path, use
# docs/examples/webui.env.example instead; Compose-only variables such as
# HOST_DOCKER_BASE, WEBUI_LOG_DIR, and WEBUI_HTTP_BIND intentionally live there.
# On first start, `wud-updater web` prints a one-time setup link for creating
# the first admin username/password.
# The dev auth bypass is only for tests/local development. WUD_WEB_TOKEN is
# optional bearer-token compatibility for API clients after setup; it is not
# used by the browser login form.
# WUD_WEB_TOKEN="replace-with-a-long-random-api-token"
# WUD_WEB_DEV_NO_AUTH="false"
# WUD_WEB_ALLOWED_ORIGINS="http://127.0.0.1:7417"
# WUD_WEB_PUBLIC_ORIGIN="https://wud.example.test"
# WUD_WEB_ALLOWED_HOSTS="updates.example.test,192.168.1.20"
# WUD_WEB_TRUSTED_PROXIES="127.0.0.1/32"
# WUD_WEB_SECURE_COOKIES="auto"
# WUD_WEB_MUTATIONS_ENABLED="false"
# WUD_WEB_RESTART_CONTAINER="wud-updater"
# WUD_API_BASE_URL="http://wud:3000"
# WUD_WEB_HOST="127.0.0.1"
# WUD_WEB_PORT="7417"
# WUD_WEB_STATIC_DIR="/path/to/built/spa"
# WUD_WEB_UPSTREAM_MAP="/path/to/upstreams.txt"

# Optional integrations.
#
# Optional for the Python wrapper in the container: query TrueNAS status by
# starting a short-lived helper container with trusted local middleware access.
# The helper image must be built with a compatible TRUENAS_API_CLIENT_REF.
# TRUENAS_STATUS_CHECK="true"
# TRUENAS_STATUS_TIMEOUT="5"

# Release-note webhooks belong in the WUD container environment unless you
# intentionally run those helpers on the host. GITHUB_TOKEN is also used by the
# WebUI release-note metadata refresh when available.
# DISCORD_RELEASES_WEBHOOK="https://discord.com/api/webhooks/example"
# DISCORD_WEBHOOK="https://discord.com/api/webhooks/example"
# ADMIN_WEBHOOK="https://discord.com/api/webhooks/example"
# GITHUB_TOKEN="ghp_example"
# MAX_COMMITS="3"
# COLOR_HEX="0x57F287"
# UPSTREAM_MAP="/wud/upstreams.txt"
# RELEASE_EMBED="/wud/github-release-embed.sh"
# LOG_DIR="/out"
