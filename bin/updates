#!/usr/bin/env bash
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd -P)"
  link_target="$(readlink "$source_path")"
  if [[ "$link_target" == /* ]]; then
    source_path="$link_target"
  else
    source_path="$source_dir/$link_target"
  fi
done

script_dir="$(cd -P "$(dirname "$source_path")" && pwd -P)"
repo_dir="$(cd "$script_dir/.." && pwd -P)"

config_file_from_args() {
  local found=0
  local selected=""

  while (($#)); do
    case "$1" in
      --config-file)
        found=1
        if (($# > 1)); then
          selected="$2"
          shift 2
          continue
        fi
        break
        ;;
      --config-file=*)
        found=1
        selected="${1#--config-file=}"
        shift
        continue
        ;;
      --)
        break
        ;;
    esac
    shift
  done

  if ((found)); then
    printf '%s\n' "$selected"
    return 0
  fi
  return 1
}

if cli_config_file="$(config_file_from_args "$@")"; then
  config_file="$cli_config_file"
else
  default_config="$HOME/.config/wudup/env"
  legacy_default_config="$HOME/.config/wud-updater/env"
  config_file="${WUDUP_CONFIG:-${WUD_UPDATER_CONFIG:-$default_config}}"
  if [[ -z "${WUDUP_CONFIG:-}" && -z "${WUD_UPDATER_CONFIG:-}" && ! -r "$config_file" && -r "$legacy_default_config" ]]; then
    config_file="$legacy_default_config"
  fi
fi

if [ -r "$config_file" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$config_file"
  set +a
  export WUDUP_CONFIG_SOURCED=1
  export WUD_UPDATER_CONFIG_SOURCED=1
fi

python_has_runtime_deps() {
  "$1" - >/dev/null 2>&1 <<'PY'
import sys
if sys.version_info < (3, 10):
    raise SystemExit(1)
import rich
import ruamel.yaml
PY
}

run_python_updates() {
  local python_bin="${PYTHON_BIN:-python3}"
  local venv_dir="${WUDUP_VENV:-${WUD_UPDATER_VENV:-$repo_dir/.venv}}"

  if [[ -z "${PYTHON_BIN:-}" && -x "$venv_dir/bin/python" ]]; then
    if ! python_has_runtime_deps "$python_bin"; then
      python_bin="$venv_dir/bin/python"
    fi
  fi

  if [[ -n "${PYTHONPATH:-}" ]]; then
    export PYTHONPATH="${repo_dir}/src:${PYTHONPATH}"
  else
    export PYTHONPATH="${repo_dir}/src"
  fi

  exec "$python_bin" -m wudup.cli updates "$@"
}

run_python_updates "$@"
