#!/usr/bin/env bash
set -uo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd -P)"
  link_target="$(readlink "$source_path")"
  if [[ "$link_target" == /* ]]; then
    source_path="$link_target"
  else
    source_path="$source_dir/$link_target"
  fi
done

script_dir="$(cd -P "$(dirname "$source_path")" && pwd -P)"
repo_dir="$(cd "$script_dir/.." && pwd -P)"

config_file="${WUD_UPDATER_CONFIG:-$HOME/.config/wud-updater/env}"

if [ -r "$config_file" ]; then
  # shellcheck source=/dev/null
  . "$config_file"
fi

python_has_runtime_deps() {
  "$1" - >/dev/null 2>&1 <<'PY'
import sys
if sys.version_info < (3, 10):
    raise SystemExit(1)
import rich
import ruamel.yaml
PY
}

python_can_run_banner() {
  "$1" - >/dev/null 2>&1 <<'PY'
import sys
raise SystemExit(0 if sys.version_info >= (3, 10) else 1)
PY
}

print_startup_banner() {
  local banner_python_bin="${PYTHON_BIN:-python3}"
  local venv_dir="${WUD_UPDATER_VENV:-$repo_dir/.venv}"
  local banner_pythonpath="$repo_dir/src"

  if [[ -z "${PYTHON_BIN:-}" && -x "$venv_dir/bin/python" ]]; then
    if ! python_can_run_banner "$banner_python_bin"; then
      banner_python_bin="$venv_dir/bin/python"
    fi
  fi
  python_can_run_banner "$banner_python_bin" || return 0

  if [[ -n "${PYTHONPATH:-}" ]]; then
    banner_pythonpath="$banner_pythonpath:$PYTHONPATH"
  fi

  PYTHONPATH="$banner_pythonpath" "$banner_python_bin" -m wud_updater.banner \
    2>/dev/null || true
}

python_self_update_github_target() {
  local self_python_bin="${PYTHON_BIN:-python3}"
  local venv_dir="${WUD_UPDATER_VENV:-$repo_dir/.venv}"
  local self_pythonpath="$repo_dir/src"

  if [[ -z "${PYTHON_BIN:-}" && -x "$venv_dir/bin/python" ]]; then
    if ! python_can_run_banner "$self_python_bin"; then
      self_python_bin="$venv_dir/bin/python"
    fi
  fi
  python_can_run_banner "$self_python_bin" || return 0

  if [[ -n "${PYTHONPATH:-}" ]]; then
    self_pythonpath="$self_pythonpath:$PYTHONPATH"
  fi

  PYTHONPATH="$self_pythonpath" "$self_python_bin" -m wud_updater.self_update \
    github-target 2>/dev/null || true
}

run_python_updates() {
  python_bin="${PYTHON_BIN:-python3}"
  venv_dir="${WUD_UPDATER_VENV:-$repo_dir/.venv}"
  if [[ -z "${PYTHON_BIN:-}" && -x "$venv_dir/bin/python" ]]; then
    if ! python_has_runtime_deps "$python_bin"; then
      python_bin="$venv_dir/bin/python"
    fi
  fi
  if [[ -n "${PYTHONPATH:-}" ]]; then
    export PYTHONPATH="${repo_dir}/src:${PYTHONPATH}"
  else
    export PYTHONPATH="${repo_dir}/src"
  fi
  exec "$python_bin" -m wud_updater.cli updates "$@"
}

case "${WUD_UPDATER_PYTHON:-true}" in
  1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn])
    run_python_updates "$@"
    ;;
  0|[Ff][Aa][Ll][Ss][Ee]|[Nn][Oo]|[Oo][Ff][Ff])
    ;;
  *)
    echo "WUD_UPDATER_PYTHON must be one of true, false, 1, 0, yes, no, on, or off" >&2
    exit 2
    ;;
esac

docker_base="${DOCKER_BASE:-$HOME/docker}"
host_docker_base="${HOST_DOCKER_BASE:-}"
wud_file="${WUD_OUT_FILE:-}"
wud_file_explicit=0
if [ -n "$wud_file" ]; then
  wud_file_explicit=1
fi
log_dir="${WUD_LOG_DIR:-./logs}"
db_path="${WUD_DB_PATH:-}"
updater="${WUD_UPDATER:-$repo_dir/bin/docker-update-from-wud}"
update_mode="${WUD_UPDATE_MODE:-stop}"
max_wait="${WUD_MAX_WAIT:-180}"
out_uid="${OUT_UID:-}"
out_gid="${OUT_GID:-}"
out_guid="${OUT_GUID:-}"
if [ -z "$out_gid" ] && [ -n "$out_guid" ]; then
  out_gid="$out_guid"
fi
lock_timeout="${WUD_LOCK_TIMEOUT:-}"
digest_pin_updates="${WUD_DIGEST_PIN_UPDATES:-}"
auto_run=0
dry_run=0
allow_tag_updates=0
self_update=1
selected_line_spec=""
remove_line_spec=""
exclude_tag_line_spec=""
recreate_excluded_services=0
tag_override_specs=()
stop_after_self_update=0
todo_entries=""
todo_file_lines=()
wud_lock_dir=""
wud_lock_held=0
wud_lock_via_sudo=0
updater_rc=0

case "${WUD_UPDATER_SELF_UPDATE:-}" in
  0|false|FALSE|False|no|NO|No|off|OFF|Off)
    self_update=0
    ;;
esac

usage() {
  cat <<EOF
Usage: updates [-y|--yes] [--dry-run] [--self-update|--no-self-update] [--allow-tag-updates] [--base PATH] [--file PATH] [--log-dir PATH] [--mode pause|stop|live] [--max-wait SECONDS]

Shows Docker updates from WUD, TrueNAS update status, and active TrueNAS alerts.
When Docker updates are pending, prompts before running docker-update-from-wud.
Interactive runs can update all, select entries, exclude entries, or skip.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -y|--yes)
      auto_run=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --allow-tag-updates)
      allow_tag_updates=1
      shift
      ;;
    --self-update)
      self_update=1
      shift
      ;;
    --no-self-update)
      self_update=0
      shift
      ;;
    --base)
      docker_base="${2:-}"
      shift 2
      ;;
    --file)
      wud_file="${2:-}"
      wud_file_explicit=1
      shift 2
      ;;
    --log-dir)
      log_dir="${2:-}"
      shift 2
      ;;
    --mode)
      update_mode="${2:-}"
      shift 2
      ;;
    --max-wait)
      max_wait="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ "$wud_file_explicit" -eq 0 ]; then
  wud_file="$docker_base/wud/out/images.todo"
fi

print_startup_banner

wud_lock_timeout_seconds() {
  local timeout="${lock_timeout:-30}"
  if [[ ! "$timeout" =~ ^[0-9]+$ ]]; then
    echo "WUD_LOCK_TIMEOUT must be an integer number of seconds" >&2
    return 1
  fi
  printf '%s' "$timeout"
}

release_wud_lock() {
  [ "$wud_lock_held" -eq 1 ] || return 0
  if [ ! -d "$wud_lock_dir" ]; then
    wud_lock_held=0
    return 0
  fi
  if [ "$wud_lock_via_sudo" -eq 1 ]; then
    sudo rmdir "$wud_lock_dir" 2>/dev/null || true
  else
    rmdir "$wud_lock_dir" 2>/dev/null || true
  fi
  wud_lock_held=0
}

cleanup() {
  release_wud_lock
}
trap cleanup EXIT

print_truenas_unreachable() {
  local check="$1" reason="${2:-}"
  if [ -n "$reason" ]; then
    echo "ℹ️  TrueNAS not reachable; skipping $check. ($reason)"
  else
    echo "ℹ️  TrueNAS not reachable; skipping $check."
  fi
}

acquire_wud_lock() {
  local timeout waited=0 lock_parent
  timeout="$(wud_lock_timeout_seconds)" || exit $?
  wud_lock_dir="${wud_file}.lock"
  lock_parent="$(dirname "$wud_lock_dir")"
  wud_lock_via_sudo=0
  if [ ! -w "$lock_parent" ]; then
    wud_lock_via_sudo=1
  fi

  while true; do
    if [ "$wud_lock_via_sudo" -eq 1 ]; then
      if [ ! -e "$wud_lock_dir" ] && sudo mkdir "$wud_lock_dir" 2>/dev/null; then
        wud_lock_held=1
        return 0
      fi
    elif mkdir "$wud_lock_dir" 2>/dev/null; then
      wud_lock_held=1
      return 0
    elif [ ! -e "$wud_lock_dir" ] && sudo mkdir "$wud_lock_dir" 2>/dev/null; then
      wud_lock_via_sudo=1
      wud_lock_held=1
      return 0
    fi

    if [ "$waited" -ge "$timeout" ]; then
      echo "Timed out waiting for WUD file lock: $wud_lock_dir" >&2
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

read_todo_entries() {
  awk '
    {
      trimmed = $0
      sub(/^[[:space:]]+/, "", trimmed)
      if (trimmed != "" && trimmed !~ /^#/) {
        print NR "\t" $0
      }
    }
  ' "$wud_file"
}

load_todo_arrays() {
  local line_no line
  todo_file_lines=()
  [ -n "$todo_entries" ] || return 0

  while IFS=$'\t' read -r line_no line; do
    [ -n "$line_no" ] || continue
    todo_file_lines+=("$line_no")
  done <<< "$todo_entries"
}

snapshot_todo_entries() {
  todo_entries=""
  if [ -e "$wud_file" ] && [ -s "$wud_file" ]; then
    acquire_wud_lock
    if [ -r "$wud_file" ]; then
      todo_entries="$(read_todo_entries || true)"
    else
      todo_entries="$(sudo awk '
        {
          trimmed = $0
          sub(/^[[:space:]]+/, "", trimmed)
          if (trimmed != "" && trimmed !~ /^#/) {
            print NR "\t" $0
          }
        }
      ' "$wud_file" || true)"
    fi
  fi
  load_todo_arrays
  release_wud_lock
}

display_todo_entries() {
  local display_no=0 line_no line
  while IFS=$'\t' read -r line_no line; do
    [ -n "$line_no" ] || continue
    display_no=$((display_no + 1))
    if [[ "$line" =~ ^(.*[^[:space:]])[[:space:]]+sha256=[^[:space:]]+$ ]]; then
      line="${BASH_REMATCH[1]}"
    fi
    printf '%s\t%s\n' "$display_no" "$line"
  done <<< "$todo_entries" | column -t
}

line_first_token() {
  local line="$1" first
  read -r first _ <<< "$line"
  printf '%s' "$first"
}

image_repo_key() {
  local image="${1%%@sha256:*}" left rest last
  left="${image%%/*}"
  if [[ "$image" == */* && ( "$left" == *.* || "$left" == *:* || "$left" == "localhost" ) ]]; then
    rest="${image#*/}"
  else
    rest="$image"
  fi
  last="${rest##*/}"
  if [[ "$last" == *:* ]]; then
    rest="${rest%:*}"
  fi
  printf '%s' "$rest" | tr '[:upper:]' '[:lower:]'
}

is_self_update_line() {
  local first key
  first="$(line_first_token "$1")"
  key="$(image_repo_key "$first")"
  [[ "$key" == "magrhino/wud-updater" || "$key" == "wud-updater" ]]
}

tag_value_valid() {
  [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]]
}

image_has_tag() {
  local image="${1%%@sha256:*}" last
  last="${image##*/}"
  [[ "$last" == *:* ]]
}

line_desired_tag() {
  local line="$1" token tag="" first
  local tokens=()
  read -r -a tokens <<< "$line"
  first="${tokens[0]:-}"
  image_has_tag "$first" || return 1
  for token in "${tokens[@]:1}"; do
    if [[ "$token" == tag=* ]]; then
      tag="${token#tag=}"
    fi
  done
  tag_value_valid "$tag" || return 1
  printf '%s' "$tag"
}

image_repo_ref() {
  local image="${1%%@sha256:*}" last
  last="${image##*/}"
  if [[ "$last" == *:* ]]; then
    image="${image%:*}"
  fi
  printf '%s' "$image"
}

image_with_tag() {
  printf '%s:%s' "$(image_repo_ref "$1")" "$2"
}

csv_contains() {
  local csv="$1" needle="$2" item
  local items=()
  [ -n "$csv" ] || return 1
  IFS=',' read -r -a items <<< "$csv"
  for item in "${items[@]}"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

csv_append_unique() {
  local csv="$1" value="$2"
  if csv_contains "$csv" "$value"; then
    printf '%s' "$csv"
  elif [ -n "$csv" ]; then
    printf '%s,%s' "$csv" "$value"
  else
    printf '%s' "$value"
  fi
}

csv_count() {
  local csv="$1" item count=0
  local items=()
  [ -n "$csv" ] || {
    printf '0'
    return 0
  }
  IFS=',' read -r -a items <<< "$csv"
  for item in "${items[@]}"; do
    [ -n "$item" ] && count=$((count + 1))
  done
  printf '%s' "$count"
}

all_display_csv() {
  local max="$1" n result=""
  for ((n=1; n<=max; n++)); do
    result="$(csv_append_unique "$result" "$n")"
  done
  printf '%s' "$result"
}

parse_display_spec() {
  local spec="$1" max="$2" cleaned part start_raw end_raw start end n result=""
  local parts=()

  cleaned="${spec//[[:space:]]/}"
  [ -n "$cleaned" ] || return 1

  IFS=',' read -r -a parts <<< "$cleaned"
  for part in "${parts[@]}"; do
    [ -n "$part" ] || return 1
    if [[ "$part" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      start_raw="${BASH_REMATCH[1]}"
      end_raw="${BASH_REMATCH[2]}"
      start=$((10#$start_raw))
      end=$((10#$end_raw))
      [ "$start" -ge 1 ] || return 1
      [ "$end" -ge "$start" ] || return 1
      [ "$end" -le "$max" ] || return 1
      for ((n=start; n<=end; n++)); do
        result="$(csv_append_unique "$result" "$n")"
      done
    elif [[ "$part" =~ ^[0-9]+$ ]]; then
      n=$((10#$part))
      [ "$n" -ge 1 ] || return 1
      [ "$n" -le "$max" ] || return 1
      result="$(csv_append_unique "$result" "$n")"
    else
      return 1
    fi
  done

  [ -n "$result" ] || return 1
  printf '%s\n' "$result"
}

complement_display_csv() {
  local selected_csv="$1" max="$2" n result=""
  for ((n=1; n<=max; n++)); do
    if ! csv_contains "$selected_csv" "$n"; then
      result="$(csv_append_unique "$result" "$n")"
    fi
  done
  printf '%s' "$result"
}

display_csv_to_file_line_csv() {
  local display_csv="$1" display idx result=""
  local displays=()
  [ -n "$display_csv" ] || return 0

  IFS=',' read -r -a displays <<< "$display_csv"
  for display in "${displays[@]}"; do
    idx=$((display - 1))
    result="$(csv_append_unique "$result" "${todo_file_lines[$idx]}")"
  done
  printf '%s' "$result"
}

write_line_spec_numbers() {
  local spec="$1" output="$2" item
  local items=()
  [ -n "$spec" ] || return 0

  IFS=',' read -r -a items <<< "$spec"
  for item in "${items[@]}"; do
    [ -n "$item" ] && printf '%s\n' "$item"
  done >> "$output"
}

write_tag_override_line_numbers() {
  local output="$1" override
  [ "${#tag_override_specs[@]}" -gt 0 ] || return 0
  for override in "${tag_override_specs[@]}"; do
    [ -n "$override" ] && printf '%s\n' "${override%%=*}"
  done >> "$output"
}

selected_lines_match_snapshot() {
  local wanted expected current line_no line
  wanted="$(mktemp "${TMPDIR:-/tmp}/wud-selected-lines.XXXXXX")" || return 1
  expected="$(mktemp "${TMPDIR:-/tmp}/wud-expected-lines.XXXXXX")" || {
    rm -f "$wanted"
    return 1
  }
  current="$(mktemp "${TMPDIR:-/tmp}/wud-current-lines.XXXXXX")" || {
    rm -f "$wanted" "$expected"
    return 1
  }

  write_line_spec_numbers "$selected_line_spec" "$wanted"
  write_line_spec_numbers "$remove_line_spec" "$wanted"
  write_line_spec_numbers "$exclude_tag_line_spec" "$wanted"
  write_tag_override_line_numbers "$wanted"
  sort -n -u "$wanted" -o "$wanted"

  while IFS=$'\t' read -r line_no line; do
    [ -n "$line_no" ] || continue
    if grep -qx -- "$line_no" "$wanted"; then
      printf '%s\t%s\n' "$line_no" "$line" >> "$expected"
    fi
  done <<< "$todo_entries"

  if [ -r "$wud_file" ]; then
    awk 'NR == FNR {wanted[$1]=1; next} FNR in wanted {print FNR "\t" $0}' "$wanted" "$wud_file" > "$current"
  else
    sudo awk 'NR == FNR {wanted[$1]=1; next} FNR in wanted {print FNR "\t" $0}' "$wanted" "$wud_file" | cat > "$current"
  fi

  if ! cmp -s "$expected" "$current"; then
    rm -f "$wanted" "$expected" "$current"
    echo "WUD file changed while selecting updates; please rerun updates." >&2
    return 1
  fi

  rm -f "$wanted" "$expected" "$current"
  return 0
}

lock_updater_handoff() {
  [ -n "$selected_line_spec$remove_line_spec$exclude_tag_line_spec" ] || [ "${#tag_override_specs[@]}" -gt 0 ] || return 0
  acquire_wud_lock
  if ! selected_lines_match_snapshot; then
    release_wud_lock
    return 1
  fi
}

choose_update_lines() {
  local todo_count choice range_reply selected_display unselected_display remove_reply
  todo_count="${#todo_file_lines[@]}"
  selected_line_spec=""
  remove_line_spec=""
  exclude_tag_line_spec=""
  recreate_excluded_services=0
  tag_override_specs=()

  while true; do
    read -r -p "Run Docker updates? [a=all, s=select, x=exclude, n=skip] " choice || choice=""
    case "$choice" in
      ""|n|N|no|NO)
        echo "⏸️  Skipped running updates."
        return 1
        ;;
      a|A|all|ALL|y|Y|yes|YES)
        prompt_tag_updates "$(all_display_csv "$todo_count")"
        return 0
        ;;
      s|S|select|SELECT)
        while true; do
          read -r -p "Enter update numbers/ranges to select: " range_reply || range_reply=""
          if [ -z "${range_reply//[[:space:]]/}" ]; then
            echo "⏸️  No selection; skipped running updates."
            return 1
          fi
          if selected_display="$(parse_display_spec "$range_reply" "$todo_count")"; then
            break
          fi
          echo "Invalid selection. Use numbers/ranges like 1,3-5."
        done
        unselected_display="$(complement_display_csv "$selected_display" "$todo_count")"
        break
        ;;
      x|X|exclude|EXCLUDE)
        while true; do
          read -r -p "Enter update numbers/ranges to exclude: " range_reply || range_reply=""
          if [ -z "${range_reply//[[:space:]]/}" ]; then
            echo "⏸️  No selection; skipped running updates."
            return 1
          fi
          if unselected_display="$(parse_display_spec "$range_reply" "$todo_count")"; then
            break
          fi
          echo "Invalid selection. Use numbers/ranges like 1,3-5."
        done
        selected_display="$(complement_display_csv "$unselected_display" "$todo_count")"
        break
        ;;
      *)
        echo "Invalid choice. Enter a, s, x, or n."
        ;;
    esac
  done

  if [ -z "$selected_display" ]; then
    echo "⏸️  No updates selected; skipped running updates."
    return 1
  fi

  selected_line_spec="$(display_csv_to_file_line_csv "$selected_display")"
  echo "Selected $(csv_count "$selected_display") of $todo_count pending update(s)."
  prompt_tag_updates "$selected_display"

  if [ -n "$unselected_display" ]; then
    read -r -p "Remove unselected entries from the WUD file before running? (y/N) " remove_reply || remove_reply=""
    case "$remove_reply" in
      [yY]|[yY][eE][sS])
        remove_line_spec="$(display_csv_to_file_line_csv "$unselected_display")"
        ;;
    esac
  fi

  return 0
}

prompt_tag_updates() {
  local display_csv="$1" display_no=0 line_no line first tag reply
  local max_display="${#todo_file_lines[@]}"
  local change_tags=0 override idx invalid
  local exclude_display exclude_display_csv exclude_lines=""
  local tag_display_csv=""
  local exclude_displays=()
  local tag_displays=()
  local tag_lines=()
  local tag_firsts=()
  local tag_values=()
  [ -n "$display_csv" ] || return 0

  while IFS=$'\t' read -r line_no line; do
    [ -n "$line_no" ] || continue
    display_no=$((display_no + 1))
    csv_contains "$display_csv" "$display_no" || continue
    tag="$(line_desired_tag "$line" 2>/dev/null || true)"
    [ -n "$tag" ] || continue
    first="$(line_first_token "$line")"
    tag_display_csv="$(csv_append_unique "$tag_display_csv" "$display_no")"
    tag_displays+=("$display_no")
    tag_lines+=("$line_no")
    tag_firsts+=("$first")
    tag_values+=("$tag")
  done <<< "$todo_entries"

  [ "${#tag_displays[@]}" -gt 0 ] || return 0

  echo "Selected tag update(s):"
  for ((idx=0; idx<${#tag_displays[@]}; idx++)); do
    printf '  %s. %s -> %s\n' \
      "${tag_displays[$idx]}" \
      "${tag_firsts[$idx]}" \
      "$(image_with_tag "${tag_firsts[$idx]}" "${tag_values[$idx]}")"
  done

  if [ "$allow_tag_updates" -eq 0 ]; then
    while true; do
      printf '%s' "Apply selected tag update entries? [y]es/[n]o/[c]hange/[e]xclude (default n): "
      read -r reply || reply=""
      case "$reply" in
        [yY]|[yY][eE][sS])
          allow_tag_updates=1
          break
          ;;
        ""|[nN]|[nN][oO])
          return 0
          ;;
        [cC]|[cC][hH][aA][nN][gG][eE])
          allow_tag_updates=1
          change_tags=1
          break
          ;;
        [eE]|[eE][xX][cC][lL][uU][dD][eE])
          if [ "${#tag_lines[@]}" -eq 1 ]; then
            exclude_display_csv="${tag_displays[0]}"
          else
            while true; do
              read -r -p "Enter tag update numbers/ranges to exclude: " reply || reply=""
              if [ -z "${reply//[[:space:]]/}" ]; then
                echo "⏸️  No tag exclusions selected."
                return 0
              fi
              if exclude_display_csv="$(parse_display_spec "$reply" "$max_display")"; then
                invalid=0
                IFS=',' read -r -a exclude_displays <<< "$exclude_display_csv"
                for exclude_display in "${exclude_displays[@]}"; do
                  if ! csv_contains "$tag_display_csv" "$exclude_display"; then
                    invalid=1
                    break
                  fi
                done
                [ "$invalid" -eq 0 ] && break
              fi
              echo "Invalid tag selection. Use listed tag update numbers/ranges like 1,3-5."
            done
          fi
          exclude_lines=""
          IFS=',' read -r -a exclude_displays <<< "$exclude_display_csv"
          for exclude_display in "${exclude_displays[@]}"; do
            for ((idx=0; idx<${#tag_lines[@]}; idx++)); do
              if [ "${tag_displays[$idx]}" = "$exclude_display" ]; then
                exclude_lines="$(csv_append_unique "$exclude_lines" "${tag_lines[$idx]}")"
                break
              fi
            done
          done
          [ -n "$exclude_lines" ] || return 0
          exclude_tag_line_spec="$exclude_lines"
          while true; do
            read -r -p "Recreate affected services so WUD sees exclusions now? (Y/n) " reply || reply=""
            case "$reply" in
              ""|[yY]|[yY][eE][sS])
                recreate_excluded_services=1
                break
                ;;
              [nN]|[nN][oO])
                recreate_excluded_services=0
                break
                ;;
              *)
                echo "Invalid choice. Enter y or n."
                ;;
            esac
          done
          return 0
          ;;
        *)
          echo "Invalid choice. Enter y, n, c, or e."
          ;;
      esac
    done
  fi

  [ "$change_tags" -eq 1 ] || return 0

  for ((idx=0; idx<${#tag_displays[@]}; idx++)); do
    display_no="${tag_displays[$idx]}"
    line_no="${tag_lines[$idx]}"
    tag="${tag_values[$idx]}"
    while true; do
      read -r -p "Override tag for update $display_no [$tag]: " override || override=""
      [ -n "$override" ] || break
      if tag_value_valid "$override"; then
        if [ "$override" != "$tag" ]; then
          tag_override_specs+=("${line_no}=${override}")
        fi
        break
      fi
      echo "Invalid tag. Use a Docker tag value like 5.2.0."
    done
  done
}

run_updater() {
  local rc
  local updater_env=()
  local updater_args=()

  updater_args=(--base "$docker_base" --file "$wud_file" --log-dir "$log_dir" --mode "$update_mode" --max-wait "$max_wait")
  [ -n "$selected_line_spec" ] && updater_args+=(--only-lines "$selected_line_spec")
  [ -n "$remove_line_spec" ] && updater_args+=(--remove-lines-before-run "$remove_line_spec")
  [ "$allow_tag_updates" -eq 1 ] && updater_args+=(--allow-tag-updates)
  if [ "${#tag_override_specs[@]}" -gt 0 ]; then
    for override in "${tag_override_specs[@]}"; do
      updater_args+=(--tag-override "$override")
    done
  fi
  [ -n "$exclude_tag_line_spec" ] && updater_args+=(--exclude-tag-lines "$exclude_tag_line_spec")
  [ "$recreate_excluded_services" -eq 1 ] && updater_args+=(--recreate-excluded-services)
  updater_args+=(--yes)

  if [ -n "$out_uid" ] || [ -n "$out_gid" ]; then
    [ -n "$out_uid" ] && updater_env+=("OUT_UID=$out_uid")
    [ -n "$out_gid" ] && updater_env+=("OUT_GID=$out_gid")
  fi
  [ -n "$db_path" ] && updater_env+=("WUD_DB_PATH=$db_path")
  [ -n "$host_docker_base" ] && updater_env+=("HOST_DOCKER_BASE=$host_docker_base")
  [ -n "$digest_pin_updates" ] && updater_env+=("WUD_DIGEST_PIN_UPDATES=$digest_pin_updates")
  [ -n "$lock_timeout" ] && updater_env+=("WUD_LOCK_TIMEOUT=$lock_timeout")
  if [ "$wud_lock_held" -eq 1 ]; then
    updater_env+=("WUD_LOCK_HELD_BY_PARENT=1")
  fi

  if ((${#updater_env[@]})); then
    echo "🚀 Running Docker updates via: sudo env ${updater_env[*]} \"$updater\" ${updater_args[*]}"
    sudo env "${updater_env[@]}" "$updater" "${updater_args[@]}"
  else
    echo "🚀 Running Docker updates via: sudo \"$updater\" ${updater_args[*]}"
    sudo "$updater" "${updater_args[@]}"
  fi
  rc=$?
  echo
  if [ "$rc" -eq 0 ]; then
    echo "✅ Update script completed (exit $rc)."
  else
    echo "❌ Update script failed (exit $rc)."
  fi
  return "$rc"
}

prompt_self_update() {
  local message="$1" reply choice
  echo
  echo "$message"
  if [ "$dry_run" -eq 1 ]; then
    echo "👀 Dry-run mode: not running WUD-Updater self-update."
    return 1
  fi
  [ "$auto_run" -eq 1 ] && return 0

  while true; do
    if ! read -r -p "Update WUD-Updater before other Docker updates? (Y/n) " reply; then
      echo "⏸️  Skipped WUD-Updater self-update."
      return 1
    fi
    choice="$(printf '%s' "$reply" | tr '[:upper:]' '[:lower:]')"
    case "$choice" in
      y|yes)
        return 0
        ;;
      "")
        if [ -t 0 ]; then
          return 0
        fi
        echo "⏸️  Skipped WUD-Updater self-update."
        return 1
        ;;
      n|no)
        echo "⏸️  Skipped WUD-Updater self-update."
        return 1
        ;;
      *)
        echo "Invalid choice. Enter y or n."
        ;;
    esac
  done
}

self_update_display_csv() {
  local display_no=0 line_no line result=""
  while IFS=$'\t' read -r line_no line; do
    [ -n "$line_no" ] || continue
    display_no=$((display_no + 1))
    if is_self_update_line "$line"; then
      result="$(csv_append_unique "$result" "$display_no")"
    fi
  done <<< "$todo_entries"
  printf '%s' "$result"
}

display_csv_has_desired_tag() {
  local display_csv="$1" display_no=0 line_no line
  while IFS=$'\t' read -r line_no line; do
    [ -n "$line_no" ] || continue
    display_no=$((display_no + 1))
    csv_contains "$display_csv" "$display_no" || continue
    line_desired_tag "$line" >/dev/null 2>&1 && return 0
  done <<< "$todo_entries"
  return 1
}

run_wud_file_self_update() {
  local display_csv="$1" count rc entry_label old_allow_tag_updates
  count="$(csv_count "$display_csv")"
  if [ "$count" = "1" ]; then
    entry_label="entry"
  else
    entry_label="entries"
  fi
  if ! prompt_self_update "🔁 WUD-Updater self-update detected in the WUD file ($count $entry_label)."; then
    return 0
  fi

  selected_line_spec="$(display_csv_to_file_line_csv "$display_csv")"
  remove_line_spec=""
  exclude_tag_line_spec=""
  recreate_excluded_services=0
  tag_override_specs=()
  old_allow_tag_updates="$allow_tag_updates"
  if display_csv_has_desired_tag "$display_csv"; then
    allow_tag_updates=1
  fi
  if lock_updater_handoff; then
    run_updater
    rc=$?
  else
    rc=$?
  fi
  release_wud_lock
  selected_line_spec=""
  remove_line_spec=""
  exclude_tag_line_spec=""
  recreate_excluded_services=0
  tag_override_specs=()
  allow_tag_updates="$old_allow_tag_updates"
  return "$rc"
}

run_github_release_self_update() {
  local target="$1" image rc

  if ! prompt_self_update "🔁 WUD-Updater release update available."; then
    return 0
  fi

  stop_after_self_update=1
  if self_update_desired_tag "$target" >/dev/null 2>&1; then
    run_github_release_tag_self_update "$target"
    return $?
  fi

  image="$(self_update_pull_image "$target")" || {
    echo "Could not determine WUD-Updater image to pull." >&2
    return 1
  }

  echo "🚀 Pulling WUD-Updater image via: sudo docker pull $image"
  sudo docker pull "$image"
  rc=$?
  echo
  if [ "$rc" -eq 0 ]; then
    echo "✅ WUD-Updater image pull completed (exit $rc)."
    echo "Please restart the wud-updater container before running updates again."
  else
    echo "❌ WUD-Updater image pull failed (exit $rc)."
  fi
  return "$rc"
}

run_github_release_tag_self_update() {
  local target="$1" tmp_dir tmp_file rc old_allow_tag_updates
  local old_wud_file old_selected_line_spec old_remove_line_spec old_exclude_tag_line_spec
  local old_recreate_excluded_services
  local -a old_tag_override_specs=()

  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/wud-self-update.XXXXXX")" || return 1
  tmp_file="$tmp_dir/images.todo"
  printf '%s\n' "$target" > "$tmp_file" || {
    rc=$?
    rm -rf "$tmp_dir"
    return "$rc"
  }

  old_wud_file="$wud_file"
  old_selected_line_spec="$selected_line_spec"
  old_remove_line_spec="$remove_line_spec"
  old_exclude_tag_line_spec="$exclude_tag_line_spec"
  old_recreate_excluded_services="$recreate_excluded_services"
  if ((${#tag_override_specs[@]})); then
    old_tag_override_specs=("${tag_override_specs[@]}")
  fi
  old_allow_tag_updates="$allow_tag_updates"
  wud_file="$tmp_file"
  selected_line_spec=""
  remove_line_spec=""
  exclude_tag_line_spec=""
  recreate_excluded_services=0
  tag_override_specs=()
  allow_tag_updates=1

  run_updater
  rc=$?

  wud_file="$old_wud_file"
  selected_line_spec="$old_selected_line_spec"
  remove_line_spec="$old_remove_line_spec"
  exclude_tag_line_spec="$old_exclude_tag_line_spec"
  recreate_excluded_services="$old_recreate_excluded_services"
  tag_override_specs=()
  if ((${#old_tag_override_specs[@]})); then
    tag_override_specs=("${old_tag_override_specs[@]}")
  fi
  allow_tag_updates="$old_allow_tag_updates"
  rm -rf "$tmp_dir"
  return "$rc"
}

self_update_pull_image() {
  local target="$1" first desired_tag

  read -r first _ <<< "$target"
  [ -n "$first" ] || return 1

  if desired_tag="$(self_update_desired_tag "$target")"; then
    image_with_tag "$first" "$desired_tag"
  else
    printf '%s\n' "$first"
  fi
}

self_update_desired_tag() {
  local target="$1" first token desired_tag=""
  local tokens=()

  read -r first _ <<< "$target"
  [ -n "$first" ] || return 1

  read -r -a tokens <<< "$target"
  for token in "${tokens[@]:1}"; do
    if [[ "$token" == tag=* ]]; then
      desired_tag="${token#tag=}"
    fi
  done

  if [ -n "$desired_tag" ] && image_has_tag "$first" && tag_value_valid "$desired_tag"; then
    printf '%s\n' "$desired_tag"
    return 0
  fi
  return 1
}

run_self_update_preflight() {
  local display_csv target rc
  [ "$self_update" -eq 1 ] || return 0
  [ -x "$updater" ] || return 0

  display_csv="$(self_update_display_csv)"
  if [ -n "$display_csv" ]; then
    run_wud_file_self_update "$display_csv"
    rc=$?
    [ "$rc" -eq 0 ] || return "$rc"
    snapshot_todo_entries
    return 0
  fi

  target="$(python_self_update_github_target)"
  target="${target%%$'\n'*}"
  [ -n "$target" ] || return 0
  run_github_release_self_update "$target"
}

echo "=== 📦 Docker Updates ==="
snapshot_todo_entries
run_self_update_preflight
self_update_rc=$?
[ "$self_update_rc" -eq 0 ] || exit "$self_update_rc"
[ "$stop_after_self_update" -eq 0 ] || exit 0

if [ -n "$todo_entries" ]; then
  display_todo_entries
else
  echo "✅ No pending Docker updates!"
fi

echo
echo "=== 🖥️ TrueNAS System Update ==="
if command -v midclt >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  sys_json="$(midclt call update.check_available 2>/dev/null)" || sys_json=""
  if [ -z "$sys_json" ]; then
    print_truenas_unreachable "system update check" "empty midclt response"
  else
    sys_update="$(printf '%s\n' "$sys_json" | jq -r '.status' 2>/dev/null)" || sys_update=""
    if [ -z "$sys_update" ] || [ "$sys_update" = "null" ]; then
      print_truenas_unreachable "system update check" "invalid JSON response"
    else
      case "$sys_update" in
        UNAVAILABLE) echo "✅ System up to date" ;;
        AVAILABLE) echo "⚠️  System update available!" ;;
        *) echo "❓ Unknown status: ${sys_update:-<no response>}" ;;
      esac
    fi
  fi
else
  print_truenas_unreachable "system update check" "midclt or jq not available"
fi

echo
echo "=== 🚨 TrueNAS Alerts ==="
if command -v midclt >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  alerts_json="$(midclt call alert.list 2>/dev/null)" || alerts_json=""
  if [ -z "$alerts_json" ]; then
    print_truenas_unreachable "alert check" "empty midclt response"
  else
    alerts="$(printf '%s\n' "$alerts_json" | jq -r '.[] | select(.dismissed==false) | .formatted' 2>/dev/null)" || alerts=""
    if [ -z "$alerts" ]; then
      if printf '%s\n' "$alerts_json" | jq -e 'type == "array"' >/dev/null 2>&1; then
        echo "✅ No active alerts"
      else
        print_truenas_unreachable "alert check" "invalid JSON response"
      fi
    else
      echo "$alerts" | nl -ba
    fi
  fi
else
  print_truenas_unreachable "alert check" "midclt or jq not available"
fi

if [ -z "$todo_entries" ]; then
  exit 0
fi

if [ ! -x "$updater" ]; then
  echo
  if [ -f "$updater" ]; then
    echo "ℹ️  Updater script found but not executable: $updater"
    echo "    Make it executable with: chmod +x \"$updater\""
  else
    echo "ℹ️  Updater script not found: $updater"
  fi
  exit 0
fi

if [ "$dry_run" -eq 1 ]; then
  echo
  echo "👀 Dry-run mode: not running updates."
  exit 0
fi

echo
if [ "$auto_run" -eq 1 ]; then
  run_updater
  exit $?
else
  if choose_update_lines; then
    lock_updater_handoff || exit $?
    run_updater
    updater_rc=$?
    release_wud_lock
    exit "$updater_rc"
  fi
fi
